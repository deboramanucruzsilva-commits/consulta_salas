# ===== Copie este arquivo para ".env" e ajuste. NUNCA envie o .env ao GitHub. =====

NODE_ENV=development
PORT=3000

# Banco MySQL local (o do docker compose). DATABASE_SSL=false SÓ para o banco local.
DATABASE_URL=mysql://salasfac:salasfac_dev@127.0.0.1:3306/salasfac
DATABASE_SSL=false
# Só se o provedor do banco usar certificado próprio (cole o PEM com \n no lugar das quebras):
# DATABASE_SSL_CA=

# Usados pelo docker compose para criar o MySQL local. Troque as senhas se o PC for exposto à rede.
MYSQL_DATABASE=salasfac
MYSQL_USER=salasfac
MYSQL_PASSWORD=salasfac_dev
MYSQL_ROOT_PASSWORD=root_dev_only

# Segredo que assina o login. OBRIGATÓRIO, mínimo 32 caracteres.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=db2ygygfi32ih3ie9u91io2h9ur1o32jh74hhg93gbh929j0f01j9
# true quando o site for servido em HTTPS (hospedagem). false em http://localhost.
COOKIE_SECURE=false

# Opcional: cria/garante um administrador sempre que o servidor inicia.
ADMIN_EMAIL=deboramanucruzsilva@gmail.com
ADMIN_PASSWORD=Adminabcdebora
# Coloque true por UM deploy se precisar redefinir a senha desse admin; depois remova.
# ADMIN_RESET_PASSWORD=true
